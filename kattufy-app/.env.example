APP_NAME=Kattufy
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# XAMPP MariaDB / MySQL 8. The kattufy database already exists (created from
# database/schema/kattufy-v1-schema.sql); migrations only add what is missing.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kattufy
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
# 30-day customer sessions (Architecture section 7). Staff panel access expires
# separately after KATTUFY_STAFF_SESSION_HOURS.
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@kattufy.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------
# Kattufy
# ---------------------------------------------------------------------
# Demo mode: fixed one-time codes, nothing is sent, demo access panel shown.
# Set to false in production together with a real SMS gateway.
KATTUFY_DEMO_MODE=true
KATTUFY_DEMO_MOBILE_CODE=123456
KATTUFY_DEMO_EMAIL_CODE=654321
# Every page except sign-in, registration and legal pages needs a login.
KATTUFY_REQUIRE_LOGIN=true
# demo = never sends; log = writes the code to storage/logs (local testing only).
# A production SMS gateway still has to be added (see README).
KATTUFY_SMS_DRIVER=demo
KATTUFY_STAFF_SESSION_HOURS=8
# One-time code limits per hour. Keep these defaults in production; raise them
# for local development, where every browser on the machine shares one IP.
KATTUFY_OTP_MAX_PER_PHONE_PER_HOUR=5
KATTUFY_OTP_MAX_PER_IP_PER_HOUR=10
# Cloudflare Turnstile. Leave empty to skip the check (development).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

VITE_APP_NAME="${APP_NAME}"
